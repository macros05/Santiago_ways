# ─────────────────────────────────────────────────────────────────────────────
# SantiagoWays API — self-hosted (.env for docker compose)
# Copy to `.env` and fill in. See .env.example for the full variable reference.
#   cp .env.production.example .env
# Generate secrets with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Postgres (the `db` service) ──────────────────────────────────────────────
# Only the password is mandatory. DATABASE_URL is DERIVED in docker-compose.yml
# from these three — do NOT set DATABASE_URL yourself.
POSTGRES_USER=santiagoways
POSTGRES_PASSWORD=            # REQUIRED — choose a strong password
POSTGRES_DB=santiagoways

# ── Public domain (Caddy HTTPS) ──────────────────────────────────────────────
# DNS A-record for this must point at the server, ports 80/443 open.
API_DOMAIN=api.santiagoways.app
APP_PUBLIC_URL=https://api.santiagoways.app   # REQUIRED (prod) — same origin, with https://

# ── Auth secrets ─────────────────────────────────────────────────────────────
JWT_SECRET=                  # REQUIRED — openssl rand -base64 32
JWT_REFRESH_SECRET=          # REQUIRED — openssl rand -base64 32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated OAuth client IDs accepted on Google id_tokens (iOS/Android/Web)
GOOGLE_CLIENT_ID=            # REQUIRED (prod)
APPLE_CLIENT_ID=            # required only if you ship Apple Sign In

# ── Daily GPS-retention cron (replaces the Vercel cron) ──────────────────────
CRON_SECRET=                 # openssl rand -base64 32 — used by the crontab call below

# ── RevenueCat (subscriptions) ───────────────────────────────────────────────
REVENUECAT_WEBHOOK_SECRET=   # REQUIRED (prod) — webhooks reject unsigned in prod
REVENUECAT_API_KEY=

# ── Optional features (leave blank to disable; the endpoint returns 503) ─────
# Cloudinary (image uploads / avatars):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Resend (password-reset email):
RESEND_API_KEY=
EMAIL_FROM="SantiagoWays <noreply@santiagoways.app>"
EMAIL_REPLY_TO=
# Pusher (chat + live map):
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
# Upstash Redis (distributed rate limiting; falls back to in-process if unset):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Booking.com via RapidAPI (albergue availability):
RAPIDAPI_KEY=
RAPIDAPI_HOST=booking-com.p.rapidapi.com
# Gemini (AI guide):
GEMINI_API_KEY=
# Offline maps:
MBTILES_BASE_URL=
RASTER_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAPBOX_ACCESS_TOKEN=

# ── Database seeding (production safety) ─────────────────────────────────────
# The seed runs a DESTRUCTIVE clear() and, by default, creates 12 demo accounts
# with the PUBLIC password "demo1234". Both are blocked in production unless you
# opt in explicitly. On a FRESH, empty prod DB, seed reference data only with:
#   SEED_ALLOW_DESTRUCTIVE=true npm run prisma:seed
# Leave SEED_DEMO unset in production. NEVER set SEED_DEMO=true on a live DB.
SEED_ALLOW_DESTRUCTIVE=
SEED_DEMO=
