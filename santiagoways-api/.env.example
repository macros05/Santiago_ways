# ────────────────────────────────────────────────────────────────────────────
# SantiagoWays API — production .env reference
#
# Variables marked **REQUIRED (prod)** are enforced at boot by lib/env.ts —
# /api/health returns 503 if any are missing in NODE_ENV=production.
# Variables marked **REQUIRED (feature)** gate a specific feature; the app
# boots without them, but the feature returns 503/disabled until configured.
# ────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# Postgres connection string. Use the pooled URL on Vercel/Render.
# REQUIRED (prod)
DATABASE_URL=postgresql://user:password@host:5432/santiagoways?schema=public

# 32-byte base64 secrets. Generate with: openssl rand -base64 32
# REQUIRED (prod)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Public URL of THIS service (used in password-reset emails). Must match the
# deployed origin including https://. REQUIRED (prod).
APP_PUBLIC_URL=https://api.santiagoways.app

# ── Google Sign In ──────────────────────────────────────────────────────────
# A comma-separated list of OAuth Client IDs that should be accepted as
# `aud` on incoming id_tokens. Typically you have one each for iOS, Android,
# and Web — list all of them.  REQUIRED (prod)
GOOGLE_CLIENT_ID=

# ── Apple Sign In ───────────────────────────────────────────────────────────
# The Service ID (web) or App ID (native) registered with Apple — must match
# the `aud` of identity_tokens issued by Apple. REQUIRED (feature: Apple)
APPLE_CLIENT_ID=

# ── Cloudinary (image uploads) ──────────────────────────────────────────────
# REQUIRED (feature: post images, avatars). Without these /uploads/sign returns 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Resend (transactional email) ────────────────────────────────────────────
# REQUIRED (feature: forgot password). Without these the endpoint silently
# no-ops (no enumeration leak) but no email is sent.
RESEND_API_KEY=
EMAIL_FROM="SantiagoWays <noreply@santiagoways.app>"
EMAIL_REPLY_TO=

# ── Pusher (realtime: chat + live pilgrim map) ──────────────────────────────
# REQUIRED (feature: chat, live map). All four must be set together.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

# ── Upstash Redis (distributed rate limiting) ───────────────────────────────
# REQUIRED (feature: rate limiting across multiple instances). Without these
# the limiter falls back to in-process state — fine for single-instance dev,
# bypassable on horizontally scaled production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── RevenueCat ──────────────────────────────────────────────────────────────
# REQUIRED (prod) — webhooks reject unsigned requests in production.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=

# ── Booking.com via RapidAPI (albergue availability) ────────────────────────
RAPIDAPI_KEY=
RAPIDAPI_HOST=booking-com.p.rapidapi.com

# ── Gemini / AI guide ───────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Offline maps ────────────────────────────────────────────────────────────
# Public CDN/bucket prefix where stage-{id}.mbtiles archives live. Without
# this the offline-map endpoint returns rasterTemplate fallback only.
MBTILES_BASE_URL=
# Override the default OSM raster fallback (e.g. self-hosted mbtileserver):
RASTER_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ── Mapbox (optional) ───────────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=

# ── Misc ────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
EXPO_ACCESS_TOKEN=
