# =============================================================================
# SantiagoWays — root env reference (copy variables you need into each project)
# =============================================================================

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://santiagoways:password@localhost:5432/santiagoways?schema=public

# --- Auth --------------------------------------------------------------------
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=replace-with-openssl-rand-base64-32
JWT_REFRESH_SECRET=replace-with-openssl-rand-base64-32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Storage (Cloudinary) ----------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Maps (Mapbox) -----------------------------------------------------------
MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_MAPBOX_TOKEN=

# --- Booking (RapidAPI) ------------------------------------------------------
RAPIDAPI_KEY=
RAPIDAPI_HOST=booking-com.p.rapidapi.com

# --- Weather (Open-Meteo, free, no key required) -----------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- Real-time (Pusher) ------------------------------------------------------
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=eu

# --- Push notifications (Expo) -----------------------------------------------
EXPO_ACCESS_TOKEN=

# --- Mobile API base URL -----------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api
