# SantiagoWays mobile app — public (EXPO_PUBLIC_*) env reference.
# These values ship inside the bundle, so DO NOT put server-side secrets here.

# Backend base URL (no trailing slash). Switch to your prod API for builds.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Map tiles: only required if you swap react-native-maps' default provider for
# Mapbox. The default OSM raster layer works without this.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Pusher (must match the cluster your API points at).
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=eu

# Google Sign In — paste the iOS/Android/Web Client ID here. expo-auth-session
# uses a single ID per platform; the backend accepts a comma-separated list
# in GOOGLE_CLIENT_ID covering all of them.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# RevenueCat platform keys (public, safe in bundle).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
